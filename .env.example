# Opcional — não usada pelo STT desde a migração para OpenAI Whisper-1
# (src/app/api/stt/route.ts). Ainda disponível como fallback de LLM: veja
# GroqAIProvider comentado em src/app/api/chat/route.ts caso queira
# voltar a usar Groq/Llama em vez do OpenAIProvider ativo.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Obrigatório — usada por OpenAITTSProvider (speechProvider padrão,
# src/app/api/tts/route.ts), OpenAIProvider (aiProvider padrão,
# src/app/api/chat/route.ts) e agora também pelo STT (Whisper-1,
# src/app/api/stt/route.ts — mesma chave, uma a menos para gerenciar).
# Vozes femininas do TTS: nova (recomendada, natural e calorosa),
# shimmer (mais suave), alloy (neutra).
OPENAI_API_KEY=
OPENAI_TTS_VOICE=nova
OPENAI_CHAT_MODEL=gpt-4o-mini

# Opcional — só necessário se você trocar o SpeechProvider para
# ElevenLabsSpeechProvider em src/app-config/providers.ts
# (rota: src/app/api/tts-elevenlabs/route.ts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Supabase — currículo (books/units/lessons/steps), sessões e o bucket
# lesson-images. RLS sem políticas: só a service_role lê/escreve, e só nas
# rotas de API do servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NUNCA em código client-side nem em variável NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
